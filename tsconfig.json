{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./ui/src/*"],
      "@shared/*": ["./src/lib/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["ui/src", "src/lib/schedule.mjs", "src/lib/schedule.d.mts", "vite.config.mts"]
}
