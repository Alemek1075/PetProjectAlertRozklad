{
  "name": "rozklad-alert",
  "productName": "Розклад і тривоги",
  "version": "2.0.0",
  "description": "Tray widget: class schedule with Zoom/Meet links, reminders, and Kyiv air-raid alert map (alerts.in.ua)",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "vite build && electron .",
    "dev": "node tools/dev.mjs",
    "ui:build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint-copy.mjs",
    "shots": "node tools/shots.mjs",
    "map": "python tools/build_map.py",
    "dist": "node tools/build.js",
    "dist:watch": "node tools/build.js --watch"
  },
  "build": {
    "appId": "ua.rozklad.alert",
    "productName": "RozkladAlert",
    "files": [
      "src/**/*",
      "build-ui/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "uk",
      "en-US"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "RozkladAlert.exe"
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller": false
  }
}
